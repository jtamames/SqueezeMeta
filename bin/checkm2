#!/usr/bin/env python


import os
import sys

###Libpath patch added by Fernando Puente-Sanchez. 25-VI-2026
SQMpath = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), '..')
libPath = SQMpath + '/lib/'
binPath = SQMpath + '/bin/'
sys.path.insert(0, libPath)
os.environ["PATH"] += os.pathsep + binPath
###

from checkm2.main import main

if __name__ == '__main__':
    main()
